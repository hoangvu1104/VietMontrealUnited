{
  "name": "GoDaddy - vmu.vietcanadianlive.com",
  "context": ".",
  "protocol": "sftp",
  "host": "YOUR_GODADDY_SFTP_HOST",
  "port": 22,
  "username": "YOUR_GODADDY_USERNAME",
  "password": "YOUR_GODADDY_PASSWORD",
  "remotePath": "/public_html/vmu/",
  "uploadOnSave": false,
  "downloadOnOpen": false,
  "useTempFile": true,
  "openSsh": false,
  "concurrency": 2,
  "connectTimeout": 20000,
  "syncOption": {
    "delete": false,
    "skipCreate": false,
    "ignoreExisting": false,
    "update": true
  },
  "ignore": [
    "/.git",
    "/.gitignore",
    "/.gitattributes",
    "/.vscode",
    "/.idea",
    "**/node_modules",
    "**/*.log",
    "**/.DS_Store",
    "**/Thumbs.db",
    "**/.env",
    "**/.env.*",
    "**/*.pem",
    "**/*.key",
    "**/*.ppk",
    "**/*.zip",
    "**/*.bak",
    "**/*.tmp",
    "**/*.swp",
    "/config/database.local.php",
    "/var",
    "/tests",
    "/scripts",
    "/database",
    "/docs",
    "/coverage",
    "/.cache",
    "/README.md",
    "/DEPLOYMENT-SFTP.md",
    "/start-local.cmd",
    "/start-local.ps1",
    "/package.json",
    "/package-lock.json",
    "/yarn.lock",
    "/pnpm-lock.yaml",
    "/public/uploads/*",
    "!/public/uploads/.htaccess"
  ]
}
